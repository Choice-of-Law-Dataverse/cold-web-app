{
  "name": "nuxt-app",
  "version": "1.5.0",
  "author": {
    "name": "Marcos Messer",
    "email": "git@marcosmesser.com",
    "url": "https://marcosmesser.com"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "nuxt build --log-level silent",
    "check": "pnpm run format && pnpm run lint:fix && pnpm run typecheck && pnpm run test:run",
    "check:ci": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:run",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "start": "nuxt start",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix --quiet",
    "format": "prettier --log-level silent --write .",
    "format:check": "prettier --log-level silent --check .",
    "knip": "knip",
    "typecheck": "vue-tsc --noEmit --pretty false -p tsconfig.json",
    "test": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:ui": "vitest --ui",
    "test:run": "vitest run --reporter=dot",
    "test:coverage": "vitest run --reporter=dot --coverage",
    "generate:api": "cd ../backend && LOGFIRE_SEND_TO_LOGFIRE=false uv run python scripts/export_openapi.py && cd ../frontend && pnpm dlx openapi-typescript app/types/openapi.json -o app/types/api-schema.d.ts"
  },
  "dependencies": {
    "@auth0/auth0-nuxt": "^1.2.1",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/material-symbols": "^1.2.95",
    "@nuxt/content": "^3.16.2",
    "@nuxt/fonts": "^1.1.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/scripts": "^1.3.12",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/leaflet": "^1.3.3",
    "@nuxtjs/robots": "^7.0.2",
    "@nuxtjs/sitemap": "^9.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@pydantic/logfire-node": "^0.18.30",
    "@tanstack/vue-query": "^5.104.5",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "mitt": "^3.0.1",
    "nuxt": "^4.6.2",
    "openapi-fetch": "^0.17.0",
    "v-calendar": "^3.1.2",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/simple-icons": "^1.2.100",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query-devtools": "^6.3.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "h3": "^1.15.11",
    "happy-dom": "^21.0.4",
    "knip": "^6.42.1",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
